package templates

import (
	"fmt"
	"time"
	"puma-gallery/commons"
)

// Helper function to format date
func formatDate(dateStr string) string {
	t, err := time.Parse(time.RFC3339, dateStr)
	if err != nil {
		return dateStr
	}
	return t.Format("Jan 2, 2006")
}

templ MainPage(images []commons.ImageData, authenticated bool) {
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Pumito Gallery - Home</title>
        <script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.7/dist/htmx.min.js"></script>
        <link href="https://cdn.jsdelivr.net/npm/daisyui@5" rel="stylesheet" type="text/css" />
        <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    </head>
    @NavBar(authenticated)
	<div 
		class="flex flex-col items-center justify-center min-h-screen p-4"
		style="background: linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%); font-family: 'Comic Neue', cursive, sans-serif;"
	>
		if len(images) == 0 {
			<div class="bg-white/90 backdrop-blur-sm rounded-3xl p-8 shadow-lg shadow-orange-200/30">
				<p class="text-xl text-orange-800 font-semibold text-center">No images found</p>
			</div>
		} else {
			<div class="w-full max-w-5xl mx-auto">
				<!-- Header -->
				<div class="text-center mb-8">
					<h1 
						class="text-5xl md:text-6xl font-bold mb-4 tracking-wider"
						style="font-family: 'Comic Neue', cursive, sans-serif; color: #fc7e4c; letter-spacing: 2px;"
					>
						PUMITO GALLERY
					</h1>
					<p class="text-lg text-orange-700/80 font-medium">
						Discover adorable moments captured in time ✨
					</p>
				</div>

				<div class="bg-white/90 backdrop-blur-sm rounded-3xl p-6 shadow-xl shadow-orange-200/30">
					<!-- Carousel -->
					<div class="carousel carousel-center w-full space-x-4 p-4">
						for _, image := range images {
							<div id={ fmt.Sprintf("slide%d", image.Id) } class="carousel-item w-full md:w-1/2 lg:w-1/3">
								<div class="card group overflow-hidden border-0 transition-all duration-300 transform hover:-translate-y-2 hover:rotate-1 w-full">
									<div class="card-body p-0">
										<div class="relative aspect-square overflow-hidden rounded-3xl border-4 border-orange-400 bg-orange-50">
											<img
												src={ image.Url }
												alt={ image.Caption }
												class="absolute inset-0 w-full h-full object-cover transition-transform duration-300 group-hover:scale-110"
											/>
											
											<!-- Playful hover overlay -->
											<div class="absolute inset-0 bg-gradient-to-t from-orange-400/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-3xl"></div>
											
											<!-- Caption card -->
											<div class="absolute bottom-3 left-2 right-2 transform">
												<div 
													class="rounded-2xl p-3 shadow-lg"
													style="background: #fff5e4;"
												>
													<p 
														class="text-sm font-bold leading-tight mb-1"
														style="font-family: 'Comic Neue', cursive, sans-serif; color: #4f3852;"
													>
														{ image.Caption }
													</p>
													<p class="text-xs text-orange-700/70">
														{ formatDate(*image.CreatedAt) }
													</p>
												</div>
											</div>
										</div>
									</div>
								</div>
							</div>
						}
					</div>

					<!-- Navigation buttons -->
					<div class="flex justify-center gap-2 py-4">
						for i, image := range images {
							<a 
								href={ templ.SafeURL(fmt.Sprintf("#slide%d", image.Id)) }
								class="btn btn-xs"
								style={ fmt.Sprintf("background: linear-gradient(90deg, #ffb09e, #f9c07d); color: #673066; %s", 
									func() string {
										if i == 0 { return "opacity: 100;" }
										return ""
									}()) }
							>
								{ fmt.Sprintf("%d", i+1) }
							</a>
						}
					</div>

					<!-- Image counter -->
					<div class="text-center mt-6">
						<div 
							class="inline-block px-4 py-2 rounded-full shadow-md"
							style="background: linear-gradient(90deg, #ffb09e, #f9c07d); color: #673066;"
						>
							<p 
								class="text-sm font-bold"
								style="font-family: 'Comic Neue', cursive, sans-serif;"
							>
								{ fmt.Sprintf("%d adorable %s 💕", len(images), func() string {
									if len(images) == 1 {
										return "moment"
									}
									return "moments"
								}()) }
							</p>
						</div>
					</div>
				</div>
			</div>
		}
	</div>
}